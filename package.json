{
  "name": "queens-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js dist",
    "test": "node --test",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply queens-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply queens-db --remote"
  }
}
